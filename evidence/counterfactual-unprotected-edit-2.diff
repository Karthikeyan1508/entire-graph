diff --git a/internal/sem/search.go b/internal/sem/search.go
index 12e58854..4faeeeb1 100644
--- a/internal/sem/search.go
+++ b/internal/sem/search.go
@@ -4169,6 +4169,14 @@ func selectDiverseCandidates(candidates []searchCandidate, topK, maxPerFile int)
 		perBaseName[strings.ToLower(filepath.Base(chosen.FilePath))]++
 		remaining = append(remaining[:bestIndex], remaining[bestIndex+1:]...)
 	}
+	// The reserve above picks WHICH regions make the cut, in the order it happened to visit
+	// files in, not in relevance order: a weak unseen-file candidate seated to satisfy the
+	// reserve can land ahead of a stronger candidate from a file already represented. Selection
+	// is a one-way decision — a region does not lose its seat because it sorts lower — but the
+	// reported order is a separate contract results[] documents (descending by score) and
+	// callers truncate on. A stable sort restores it without touching who was picked: a
+	// reserved candidate keeps its seat, it is just reported where its own score places it.
+	sortSearchCandidates(selected)
 	return selected
 }
 
